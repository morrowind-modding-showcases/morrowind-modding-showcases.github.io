{
  "name": "morrowind-modding-showcases",
  "private": true,
  "scripts": {
    "content:migrate": "node scripts/migrate-content.mjs",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:check": "node scripts/validate-content.mjs --check-generated",
    "content:sync-generated": "node scripts/sync-content-from-generated.mjs",
    "resources:build": "node scripts/build-resources-page.mjs",
    "resources:sync-tags": "node scripts/sync-resource-tag-options.mjs",
    "validate:wiki": "node scripts/validate-wiki-content.mjs",
    "build:wiki-data": "node scripts/generate-wiki-data.mjs",
    "build:wiki-contribution-options": "node scripts/generate-wiki-contribution-options.mjs",
    "build:wiki-contribution-history": "node scripts/wiki-contribution-data.mjs",
    "sync:wiki-events": "node scripts/sync-wiki-event-metadata.mjs",
    "organize:wiki-locations": "node scripts/organize-wiki-locations.mjs",
    "build:map-data": "node scripts/generate-mod-map-data.mjs map/data/mods.json",
    "build:location-data": "node scripts/generate-location-map-data.mjs map/data/locations.json",
    "build:site": "node scripts/build-site.mjs && npm --prefix wiki run build && node scripts/generate-wiki-contribution-options.mjs dist/wiki/static/contribution-options.json && node scripts/wiki-contribution-data.mjs dist/wiki/static/contribution-history.json",
    "serve:site": "node scripts/serve-gh-pages.mjs 8123 dist",
    "test": "node --test scripts/*.test.mjs scripts/*.test.cjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1"
  }
}

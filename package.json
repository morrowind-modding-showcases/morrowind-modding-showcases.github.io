{
  "name": "morrowind-modding-showcases",
  "private": true,
  "scripts": {
    "content:migrate": "node scripts/migrate-content.mjs",
    "content:build": "node scripts/build-content.mjs",
    "content:validate": "node scripts/validate-content.mjs",
    "content:check": "node scripts/validate-content.mjs --check-generated",
    "content:sync-generated": "node scripts/sync-content-from-generated.mjs",
    "validate:wiki": "node scripts/validate-wiki-content.mjs",
    "build:map-data": "node scripts/generate-mod-map-data.mjs map/data/mods.json",
    "build:site": "node scripts/build-site.mjs && npm --prefix wiki run build",
    "serve:site": "node scripts/serve-gh-pages.mjs 8123 dist",
    "test": "node --test scripts/*.test.mjs scripts/*.test.cjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1"
  }
}
